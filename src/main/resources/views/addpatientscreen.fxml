<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="gui.controllers.AddPatientFormController"
            prefWidth="850"
            prefHeight="700"
            stylesheets="@../styles/patientform.css">

    <center>
        <ScrollPane fitToWidth="true"
                    fitToHeight="true"
                    pannable="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    styleClass="form-scroll-pane">

            <content>
                <VBox spacing="16" alignment="TOP_LEFT">
                    <padding>
                        <Insets top="20" right="30" bottom="20" left="30"/>
                    </padding>

                    <!-- Page title -->
                    <Label text="Κάρτα Ασθενή" styleClass="page-title"/>

                    <Separator/>

                    <!-- Personal Info -->
                    <VBox spacing="10">
                        <Label text="Προσωπικά Στοιχεία" styleClass="section-title"/>

                        <GridPane hgap="12" vgap="10" maxWidth="Infinity">

                            <columnConstraints>
                                <ColumnConstraints minWidth="140" prefWidth="160"/>
                                <ColumnConstraints hgrow="ALWAYS" fillWidth="true"/>
                            </columnConstraints>

                            <Label text="Όνομα:"
                                   GridPane.rowIndex="0"
                                   GridPane.columnIndex="0"/>

                            <TextField fx:id="firstNameField"
                                       maxWidth="Infinity"
                                       GridPane.hgrow="ALWAYS"
                                       GridPane.rowIndex="0"
                                       GridPane.columnIndex="1"/>

                            <Label text="Επώνυμο:"
                                   GridPane.rowIndex="1"
                                   GridPane.columnIndex="0"/>

                            <TextField fx:id="lastNameField"
                                       maxWidth="Infinity"
                                       GridPane.hgrow="ALWAYS"
                                       GridPane.rowIndex="1"
                                       GridPane.columnIndex="1"/>

                            <Label text="ΑΜΚΑ:"
                                   GridPane.rowIndex="2"
                                   GridPane.columnIndex="0"/>

                            <TextField fx:id="amkaField"
                                       prefWidth="200"
                                       maxWidth="200"
                                       GridPane.hgrow="ALWAYS"
                                       GridPane.rowIndex="2"
                                       GridPane.columnIndex="1"/>

                            <Label text="Τηλέφωνο:"
                                   GridPane.rowIndex="3"
                                   GridPane.columnIndex="0"/>

                            <TextField fx:id="phoneField"
                                       GridPane.hgrow="ALWAYS"
                                       prefWidth="170"
                                       maxWidth="170"
                                       GridPane.rowIndex="3"
                                       GridPane.columnIndex="1"/>

                            <Label text="Κάπνισμα:"
                                   GridPane.rowIndex="4"
                                   GridPane.columnIndex="0"/>

                            <ComboBox fx:id="smokingComboBox"
                                      promptText="Επιλογή"
                                      prefWidth="150"
                                      maxWidth="150"
                                      GridPane.hgrow="ALWAYS"
                                      GridPane.rowIndex="4"
                                      GridPane.columnIndex="1"/>

                            <Label text="Σωματικά Στοιχεία:"
                                   GridPane.rowIndex="5"
                                   GridPane.columnIndex="0"/>

                            <HBox spacing="8"
                                  GridPane.rowIndex="5"
                                  GridPane.columnIndex="1">

                                <TextField fx:id="heightField"
                                           prefWidth="100"
                                           maxWidth="100"
                                           promptText="Ύψος cm"/>

                                <TextField fx:id="weightField"
                                           prefWidth="100"
                                           maxWidth="100"
                                           promptText="Βάρος kg"/>

                                <TextField fx:id="bmiField"
                                           prefWidth="100"
                                           maxWidth="100"
                                           editable="false"
                                           focusTraversable="false"
                                           promptText="BMI"
                                           styleClass="readonly-field"/>

                            </HBox>

                        </GridPane>
                    </VBox>

                    <Separator/>

                    <VBox spacing="10">
                        <Label text="Ιατρικές Πληροφορίες" styleClass="section-title"/>

                        <HBox spacing="14">

                            <!-- Medical History -->
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Ιστορικό:"/>

                                <TextArea fx:id="medicalHistoryArea"
                                          wrapText="true"
                                          prefRowCount="6"
                                          maxWidth="Infinity"/>
                            </VBox>

                            <!-- Chronic Medication -->
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Χ. Φαρμακευτική Αγωγή:"/>

                                <TextArea fx:id="chronicMedicationArea"
                                          wrapText="true"
                                          prefRowCount="6"
                                          maxWidth="Infinity"/>
                            </VBox>

                        </HBox>

                        <VBox spacing="6">
                            <Label text="Σημειώσεις:"/>

                            <TextArea fx:id="notesArea"
                                      wrapText="true"
                                      prefRowCount="3"
                                      maxWidth="Infinity"/>
                        </VBox>

                    </VBox>

                    <Separator/>

                    <!-- Vaccines Section -->
                    <VBox spacing="10">
                        <Label text="Εμβόλια" styleClass="section-title"/>

                        <!-- Add New Vaccine -->
                        <VBox spacing="6" styleClass="injection-add-box">
                            <HBox spacing="15" alignment="CENTER_LEFT">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Τύπος Εμβολίου" styleClass="field-label-centered" maxWidth="Infinity"/>
                                    <TextField fx:id="vaccineTypeField"
                                               maxWidth="Infinity"
                                               HBox.hgrow="ALWAYS"/>
                                </VBox>

                                <VBox spacing="4">
                                    <Label text="Ημερομηνία" styleClass="field-label-centered" maxWidth="Infinity"/>
                                    <DatePicker fx:id="vaccineDatePicker"
                                                prefWidth="150"
                                                styleClass="date-picker-clean"/>
                                </VBox>

                                <VBox spacing="4">
                                    <Label text="Δόση" styleClass="field-label-centered" maxWidth="Infinity"/>
                                    <TextField fx:id="vaccineDoseField"
                                               prefWidth="70"
                                               maxWidth="70"/>
                                </VBox>

                                <VBox spacing="4" alignment="BOTTOM_LEFT">
                                    <Button text="+ Προσθήκη"
                                            fx:id="addVaccineButton"
                                            styleClass="add-button"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Vaccines Table -->
                        <VBox spacing="6">
                            <Label text="Ιστορικό Εμβολίων:"/>

                            <TableView fx:id="vaccinesTable"
                                       prefHeight="130"
                                       minHeight="100"
                                       maxWidth="Infinity"
                                       VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="vaccineTypeColumn"
                                                 text="Τύπος Εμβολίου"
                                                 prefWidth="250"/>
                                    <TableColumn fx:id="vaccineDateColumn"
                                                 text="Ημερομηνία"
                                                 prefWidth="110"/>
                                    <TableColumn fx:id="vaccineDoseColumn"
                                                 text="Δόση"
                                                 prefWidth="70"/>
                                    <TableColumn fx:id="vaccineTotalDosesColumn"
                                                 text="Συνολικές Δόσεις"
                                                 prefWidth="190"/>
                                </columns>
                            </TableView>

                            <!-- Summary -->
                            <HBox spacing="10" alignment="CENTER_RIGHT">
                                <Label text="Συνολικά Εμβόλια:" styleClass="summary-label"/>
                                <Label fx:id="totalVaccinesLabel"
                                       text="0"
                                       styleClass="summary-value"/>
                            </HBox>
                        </VBox>
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER">
            <padding>
                <Insets top="10" right="30" bottom="15" left="30"/>
            </padding>

            <Label fx:id="formErrorLabel"
                   visible="false"
                   managed="false"
                   wrapText="true"
                   maxWidth="280"
                   styleClass="form-error-label"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Ακύρωση"
                    fx:id="cancelButton"
                    onAction="#cancelForm"
                    styleClass="secondary-button"/>

            <Button text="Αποθήκευση"
                    fx:id="saveButton"
                    onAction="#savePressed"
                    styleClass="primary-button"/>

        </HBox>
    </bottom>

</BorderPane>