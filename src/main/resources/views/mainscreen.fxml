<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="gui.controllers.PatientDashboardController"
            prefWidth="1600"
            prefHeight="900"
            stylesheets="@../styles/mainscreen.css">

    <!-- Top search bar -->
    <top>
        <HBox spacing="14" alignment="CENTER_LEFT" prefHeight="90" styleClass="top-bar">
            <padding>
                <Insets top="18" right="30" bottom="18" left="30"/>
            </padding>

            <!-- Top-left logo -->
            <ImageView fitWidth="150"
                       fitHeight="70"
                       preserveRatio="true"
                       smooth="true"
                       styleClass="top-left-logo">
                <image>
                    <Image url="@../images/doctorlogo2.png"/>
                </image>
            </ImageView>

            <!-- Spacer pushes search area toward center/right -->
            <Region HBox.hgrow="ALWAYS"/>

            <TextField fx:id="searchField"
                       promptText="Αναζήτηση με όνομα ή ΑΜΚΑ"
                       prefWidth="750"
                       maxWidth="900"/>

            <Button fx:id="searchPatient"
                    styleClass="icon-button"
                    onAction="#searchPatient">
                <graphic>
                    <ImageView fitWidth="22"
                               fitHeight="22"
                               preserveRatio="true">
                        <image>
                            <Image url="@../images/searchbutton.png"/>
                        </image>
                    </ImageView>
                </graphic>
            </Button>

            <Label fx:id="searchErrorLabel"
                   visible="false"
                   managed="false"
                   styleClass="search-error-label"/>

            <!-- Optional second spacer to keep search more centered -->
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <!-- Left selected patient info -->
    <left>
        <VBox spacing="16" prefWidth="420" alignment="TOP_LEFT">
            <padding>
                <Insets top="45" right="30" bottom="25" left="35"/>
            </padding>

            <Label text="Επιλεγμένος Ασθενής" styleClass="section-title"/>

            <GridPane prefWidth="350"
                      maxWidth="350"
                      prefHeight="320"
                      maxHeight="320"
                      styleClass="info-table">

                <Label text="ID:"
                       styleClass="info-cell-label"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="0"/>

                <Label fx:id="selectedPatientIdLabel"
                       text="-"
                       styleClass="info-cell-value"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="1"/>

                <Label text="Όνομα:"
                       styleClass="info-cell-label"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="0"/>

                <Label fx:id="selectedFirstNameLabel"
                       text="-"
                       styleClass="info-cell-value"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="1"/>

                <Label text="Επίθετο:"
                       styleClass="info-cell-label"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="0"/>

                <Label fx:id="selectedLastNameLabel"
                       text="-"
                       styleClass="info-cell-value"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="1"/>

                <Label text="Τηλέφωνο:"
                       styleClass="info-cell-label"
                       GridPane.rowIndex="3"
                       GridPane.columnIndex="0"/>

                <Label fx:id="selectedPhoneLabel"
                       text="-"
                       styleClass="info-cell-value"
                       GridPane.rowIndex="3"
                       GridPane.columnIndex="1"/>

                <Label text="ΑΜΚΑ:"
                       styleClass="info-cell-label"
                       GridPane.rowIndex="4"
                       GridPane.columnIndex="0"/>

                <Label fx:id="selectedAmkaLabel"
                       text="-"
                       styleClass="info-cell-value"
                       GridPane.rowIndex="4"
                       GridPane.columnIndex="1"/>

                <Label text="Ύψος:"
                       styleClass="info-cell-label"
                       GridPane.rowIndex="5"
                       GridPane.columnIndex="0"/>

                <Label fx:id="selectedHeightLabel"
                       text="-"
                       styleClass="info-cell-value"
                       GridPane.rowIndex="5"
                       GridPane.columnIndex="1"/>

                <Label text="Βάρος:"
                       styleClass="info-cell-label"
                       GridPane.rowIndex="6"
                       GridPane.columnIndex="0"/>

                <Label fx:id="selectedWeightLabel"
                       text="-"
                       styleClass="info-cell-value"
                       GridPane.rowIndex="6"
                       GridPane.columnIndex="1"/>

                <Label text="BMI:"
                       styleClass="info-cell-label"
                       GridPane.rowIndex="7"
                       GridPane.columnIndex="0"/>

                <Label fx:id="selectedBMILabel"
                       text="-"
                       styleClass="info-cell-value"
                       GridPane.rowIndex="7"
                       GridPane.columnIndex="1"/>

                <Label text="Καπνιστής:"
                       styleClass="info-cell-label"
                       GridPane.rowIndex="8"
                       GridPane.columnIndex="0"/>

                <Label fx:id="selectedSmokerLabel"
                       text="-"
                       styleClass="info-cell-value"
                       GridPane.rowIndex="8"
                       GridPane.columnIndex="1"/>

            </GridPane>

            <Button fx:id="morePatientInfoButton"
                    text="Επιπλέον Πληροφορίες"
                    onAction="#showFUllPatientInfo"
                    prefWidth="350"/>
        </VBox>
    </left>

    <!-- Center patient table -->
    <center>
        <VBox spacing="10"
              prefWidth="900"
              maxWidth="Infinity"
              VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="30" right="30" bottom="20"/>
            </padding>

            <Label text="Λίστα Ασθενών" styleClass="section-title"/>

            <TableView fx:id="patientTable"
                       prefWidth="900"
                       VBox.vgrow="ALWAYS"
                       maxWidth="Infinity"
                       maxHeight="Infinity">

                <columns>
                    <TableColumn fx:id="idColumn"
                                 text="ID"
                                 prefWidth="60"
                                 minWidth="50"
                                 maxWidth="70"/>

                    <TableColumn fx:id="firstNameColumn"
                                 text="Όνομα"
                                 prefWidth="230"
                                 minWidth="140"/>

                    <TableColumn fx:id="lastNameColumn"
                                 text="Επίθετο"
                                 prefWidth="230"
                                 minWidth="140"/>

                    <TableColumn fx:id="amkaColumn"
                                 text="ΑΜΚΑ"
                                 prefWidth="140"
                                 minWidth="120"
                                 maxWidth="160"/>
                </columns>
            </TableView>

            <HBox alignment="CENTER" spacing="28" prefHeight="80">
                <padding>
                    <Insets top="18" right="10" bottom="10" left="10"/>
                </padding>

                <Button fx:id="addPatient" onAction="#openNewPatientForm">
                    <graphic>
                        <ImageView fitWidth="22"
                                   fitHeight="22"
                                   preserveRatio="true">
                            <image>
                                <Image url="@../images/user-plus-solid.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                </Button>

                <Button fx:id="editPatient" onAction="#openSelectedPatientForm">
                    <graphic>
                        <ImageView fitWidth="22"
                                   fitHeight="22"
                                   preserveRatio="true">
                            <image>
                                <Image url="@../images/user-pen-solid.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                </Button>

                <Button fx:id="deletePatient"
                        styleClass="danger-button"
                        onAction="#deleteSelectedPatient">
                    <graphic>
                        <ImageView fitWidth="22"
                                   fitHeight="22"
                                   preserveRatio="true">
                            <image>
                                <Image url="@../images/trash-solid.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </center>

    <!-- Right patient visits -->
    <right>
        <VBox spacing="10"
              prefWidth="360"
              maxWidth="360"
              VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="30" right="35" bottom="20"/>
            </padding>

            <Label text="Επισκέψεις Ασθενή" styleClass="section-title"/>

            <TableView fx:id="visitTable"
                       prefWidth="320"
                       maxWidth="320"
                       VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="visitIdColumn"
                                 text="ID"
                                 prefWidth="45"
                                 minWidth="40"
                                 maxWidth="50"
                                 resizable="false"/>

                    <TableColumn fx:id="visitDateColumn"
                                 text="Ημερομηνία"
                                 prefWidth="185"/>

                    <TableColumn fx:id="viewVisitColumn"
                                 prefWidth="88"/>
                </columns>
            </TableView>

            <HBox alignment="CENTER" spacing="24" prefHeight="80">
                <padding>
                    <Insets top="18" right="10" bottom="10" left="10"/>
                </padding>

                <Button fx:id="addVisit" onAction="#openNewVisitForm">
                    <graphic>
                        <ImageView fitWidth="24"
                                   fitHeight="24"
                                   preserveRatio="true">
                            <image>
                                <Image url="@../images/visit-add.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                </Button>

                <Button fx:id="editVisit" onAction="#openSelectedVisitForm">
                    <graphic>
                        <ImageView fitWidth="24"
                                   fitHeight="24"
                                   preserveRatio="true">
                            <image>
                                <Image url="@../images/edit-visit.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                </Button>

                <Button fx:id="deleteVisit"
                        styleClass="danger-button"
                        onAction="#deleteSelectedVisit">
                    <graphic>
                        <ImageView fitWidth="24"
                                   fitHeight="24"
                                   preserveRatio="true">
                            <image>
                                <Image url="@../images/trash-solid.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </right>

</BorderPane>